# Localhost environment (Socket Mode, no public webhook or ngrok required)
APP_ENV=localhost
SLACK_SOCKET_MODE=true

# Slack credentials (from api.slack.com/apps)
SLACK_BOT_TOKEN=xoxb-your-bot-token
SLACK_SIGNING_SECRET=your-signing-secret
SLACK_APP_TOKEN=xapp-1-your-socket-mode-app-token

# Applied AI Platform BFF
BFF_URL=http://localhost:8000
BFF_API_KEY=
PORT=3001
